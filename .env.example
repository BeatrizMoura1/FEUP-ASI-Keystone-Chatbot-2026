# Which LLM to use: gemini (default) or ollama
LLM_PROVIDER=gemini

# Gemini (free tier): create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here
GEMINI_MODEL=gemini-3.5-flash-lite

# Ollama (optional, local): install from https://ollama.com, then `ollama pull llama3.2`
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# How many earlier chat messages are sent with each question (0 = no follow-up context)
CHAT_HISTORY_MESSAGES=6
