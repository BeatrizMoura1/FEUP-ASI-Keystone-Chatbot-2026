# Gemini (free tier): create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here
GEMINI_MODEL=gemini-3.5-flash-lite

# How many earlier chat messages are sent with each question (0 = no follow-up context)
CHAT_HISTORY_MESSAGES=6

# PostgreSQL: local in development, Neon in production
DATABASE_URL=postgresql://localhost/keystone
TEST_DATABASE_URL=postgresql://localhost/keystone_test

# Test account passwords used by `python -m db.reset`
EMPLOYEE_PASSWORD=choose-a-password
NEWHIRE_PASSWORD=choose-a-password
ADMIN_PASSWORD=choose-a-password
